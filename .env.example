# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# Used by the api/chat.ts serverless function. Never prefix it with VITE_,
# which would expose it to the browser bundle.
GEMINI_API_KEY=""

# APP_URL: The URL where this app is hosted.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# TELEGRAM_BOT_TOKEN: The token for your Telegram bot.
# Server-side only (used by api/notify.ts when implemented). Never prefix it
# with VITE_, which would expose it to the browser bundle.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_CHAT_ID: The chat ID where the bot should send messages.
# You can get your chat ID by messaging @userinfobot on Telegram.
TELEGRAM_CHAT_ID=""
