{
  "entities": {
    "ChatMessage": {
      "title": "Chat Message",
      "description": "A message sent in the chat widget",
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "The content of the message"
        },
        "sender": {
          "type": "string",
          "enum": ["user", "ai", "coach"],
          "description": "Who sent the message"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "When the message was sent"
        },
        "sessionId": {
          "type": "string",
          "description": "Unique ID for the chat session"
        }
      },
      "required": ["text", "sender", "timestamp", "sessionId"]
    }
  },
  "firestore": {
    "/chats/{sessionId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Messages within a specific chat session"
    }
  }
}
